---
layout: base.njk
pagination:
  data: db.bookChapters
  size: 1
  alias: c
permalink: "{{ c.bookUrl }}"
eleventyComputed:
  title: "{{ c.label }}｜参考書"
  description: "作業環境測定士試験の参考書「{{ c.label }}」。過去問で繰り返し狙われる罠の型を、理由から理解できるように解説します。"
---
{% from "crumbs.njk" import crumbs %}
{{ crumbs([{name: "ホーム", url: "/"}, {name: "参考書", url: "/book/"}, {name: c.label}]) }}
<article class="book">
  <h1>{{ c.label }}</h1>
  {% if c.bookToc.length %}
  <nav class="toc" aria-label="この章の目次">
    <p class="toc-title">この章の内容</p>
    <ol>{% for t in c.bookToc %}<li><a href="#{{ t.id }}">{{ t.title }}</a></li>{% endfor %}</ol>
  </nav>
  {% endif %}
  <div class="book-body">{{ c.bookHtml | safe }}</div>
  <div class="book-actions">
    {% if c.questions.length %}<a class="button" href="/#chapter={{ c.id }}">この章の過去問を解く（{{ c.questions.length }}問）</a>{% endif %}
    <a class="button ghost" href="{{ c.url }}">この章で狙われる罠の型</a>
  </div>
  <nav class="pager" aria-label="前後の章">
    {% if c.bookPrev %}<a href="{{ c.bookPrev.url }}" rel="prev">← {{ c.bookPrev.label }}</a>{% else %}<span></span>{% endif %}
    {% if c.bookNext %}<a href="{{ c.bookNext.url }}" rel="next">{{ c.bookNext.label }} →</a>{% endif %}
  </nav>
</article>

{# 問題カード。q（db.questions の1件）と link（一覧から使うとき true）を受け取る #}
{% macro card(q, site, link=false) %}
<article class="q" id="{{ q.id }}">
  <div class="qmeta">
    <span>{{ q.exam.label }}（{{ q.exam.held }}）</span>
    <span class="subj">{{ q.subjectName }}</span>
    {% if q.rank %}<span class="rank rank-{{ q.rank }}" title="過去の出題頻度から見た、この問題の区分">{{ q.rankLabel }}</span>{% if q.method %}<span class="method">{{ q.method }}</span>{% endif %}{% endif %}
    {% if not q.published %}<span class="draft">下書き</span>{% endif %}
  </div>
  <h2 class="qtitle">{% if link %}<a href="{{ q.url }}">問{{ q.num }}</a>{% else %}問{{ q.num }}{% endif %}</h2>
  {% if q.stemHtml %}
    <div class="qtext">{{ q.stemHtml | safe }}</div>
    {% for f in q.figures %}<figure class="fig"><img src="{{ f.src }}" alt="{{ f.alt }}" loading="lazy"></figure>{% endfor %}
    {% if q.columns %}
    <div class="choice-table-wrap"><table class="choices choice-table">
      <thead><tr><th></th>{% for h in q.columns %}<th scope="col">{{ h }}</th>{% endfor %}</tr></thead>
      <tbody>{% for row in q.choiceCells %}<tr data-n="{{ loop.index }}"><th scope="row" class="n">({{ loop.index }})</th>{% for cell in row %}<td>{{ cell | safe }}</td>{% endfor %}</tr>{% endfor %}</tbody>
    </table></div>
    {% else %}
    <ol class="choices">
      {% for c in q.choices %}<li data-n="{{ loop.index }}"><span class="n">({{ loop.index }})</span><span>{{ c | safe }}</span></li>{% endfor %}
    </ol>
    {% endif %}
  {% else %}
    {% if q.summary %}<p class="qtext">{{ q.summary }}</p>{% endif %}
    <p class="source">問題文と選択肢は<a href="{{ q.sourcePdf }}" rel="noopener">公式の公表試験問題（PDF）</a>でご確認ください。</p>
  {% endif %}
  <div class="tags">
    {% for c in q.chapters %}<a class="tag" href="{{ c.url }}">{{ c.label }}</a>{% endfor %}
  </div>
  <button type="button" class="reveal" aria-expanded="false" aria-controls="ans-{{ q.id }}" data-answer="{{ q.answer | join(',') }}"{% if not q.hasExplanation %} data-noexp="1"{% endif %}>{% if q.hasExplanation %}解説を見る{% else %}正答を見る{% endif %}</button>
  <div class="answer" id="ans-{{ q.id }}" hidden>
    {% if q.answer.length %}<p class="seikai">正答 <b>{% if q.answer[0] == 'all' %}全員正解{% else %}({{ q.answer | join(')・(') }}){% endif %}</b></p>{% endif %}
    {% if q.textNote %}<p class="lawnote">原文について：{{ q.textNote }}</p>{% endif %}
    {% if q.examNote %}<p class="lawnote">協会の注記：{{ q.examNote }}</p>{% endif %}
    {% if q.lawNote %}<p class="lawnote">法改正に関する注意：{{ q.lawNote }}</p>{% endif %}
    {% if q.hasExplanation %}{{ q.explanationHtml | safe }}{% endif %}
    {% if q.reviewNote %}<p class="review-note"><b>現在、管理者にて確認中</b>{{ q.reviewNote }}</p>{% endif %}
    {% if q.minorNote %}<p class="minor-note"><b>細かい論点なので、深追いは禁物です。</b>{{ q.minorNote }}</p>{% endif %}
    {% if q.choiceNotes.length %}
    <ol class="notes">
      {% for n in q.choiceNotes %}<li{% if n.isAnswer %} class="is-answer"{% endif %}><span class="n">({{ loop.index }})</span><span>{{ n.html | safe }}</span></li>{% endfor %}
    </ol>
    {% endif %}
    {% if q.freq %}
    <section class="freq">
      {% if q.freq.level %}<p class="level lv-{{ q.freq.level.code }}"><b>{{ q.freq.level.head }}</b></p>
      <p class="level-why">理由：{{ q.freq.level.reason }}</p>
      {% if q.freq.subst %}<p class="principle-link">物質の表で解く：<a href="{{ q.freq.subst.url }}">{{ q.freq.subst.name }}</a>（ガイドブックの物質別各論）</p>{% endif %}
      {% if q.freq.principle %}<p class="principle-link">原理から解く：<a href="{{ q.freq.principle.url }}">{{ q.freq.principle.name }}</a>（過去{{ q.freq.denom }}回中{{ q.freq.principle.count }}回出題）</p>{% endif %}
      <p class="freq-note">この区分は、過去の全回の出題にもとづく目安です。</p>{% endif %}
      <h3>出題頻度</h3>
      <p class="freq-lead">この科目の過去{{ q.freq.denom }}回のうち、同じ内容が出題された回数です（同じ回に重複しても1回と数えます。頻度は、問われている論点（同じ事実のまとまり）の出題回数です）。{% if q.freq.recentLabel %}「直近」は、この科目の{{ q.freq.recentLabel }}のうち、同じ論点が出題された回数で、通算に比べて直近に集中しているものには「トレンド」の印を付けています。{% endif %}</p>
      <ol class="freq-list">{% for f in q.freq.items %}<li{% if f.hi %} class="hi"{% endif %}>{% if q.freq.kind == "choice" %}<span class="n">({{ loop.index }})</span>{% endif %}<span>{{ f.truth }}{% if f.tag %}<span class="tagt t-{{ f.tagCode }}">{{ f.tag }}</span>{% endif %}：{{ f.text }}{% if f.simText %}<span class="sim">／{{ f.simText }}</span>{% endif %}{% if f.recentText %}<span class="recent{% if f.trending %} trend{% endif %}">{{ f.recentText }}{% if f.trending %}<span class="tagt t-trend">トレンド</span>{% endif %}</span>{% endif %}{% if f.prText %}<span class="pt pr"><a href="{{ f.prUrl }}">{{ f.prText }}</a></span>{% endif %}</span></li>{% endfor %}</ol>
    </section>
    {% endif %}
    {% for t in q.traps %}{% if not t.misc and not t.hidden %}
    <section class="trap">
      <h3>この問題のひっかけパターン：{% if t.url %}<a href="{{ t.url }}">{{ t.name }}</a>{% else %}{{ t.name }}{% endif %}</h3>
      {{ t.understandingHtml | safe }}
      {% if t.reasonHtml %}<div class="why"><span>なぜ？</span>{{ t.reasonHtml | safe }}</div>{% endif %}
    </section>
    {% endif %}{% endfor %}
    {% if q.books.length %}
    <div class="review">
      {% for b in q.books %}<a class="book-link" href="{{ b.url }}" target="_blank" rel="noopener">参考書「{{ b.label }}」で復習する<span class="ext" aria-label="（新しいタブで開きます）">↗</span></a>{% endfor %}
    </div>
    {% endif %}
  </div>
  {% if q.stemHtml %}<p class="credit">出典：{{ q.source }}</p>{% endif %}
</article>
{% endmacro %}
